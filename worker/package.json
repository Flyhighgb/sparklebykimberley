{
  "name": "sparkle-orders-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute sparkle-orders --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute sparkle-orders --local --file=schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
