---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="Oops! This page has floated away like a paper aeroplane." noindex>
  <section class="page-hero confetti">
    <div class="container">
      <span class="script" style="font-size:3rem;color:var(--pink-ink)">Oops!</span>
      <h1>This page has floated away</h1>
      <p>Like a paper aeroplane on a windy day. Let's get you somewhere sparkly.</p>
      <p><a class="btn sparkle-hover" href="/">Back home</a> <a class="btn btn--white sparkle-hover" href="/tutorials">Browse tutorials</a></p>
    </div>
  </section>
</Base>
