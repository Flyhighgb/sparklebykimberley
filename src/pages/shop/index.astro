---
import Base from '../../layouts/Base.astro';
import ShopGrid from '../../components/ShopGrid.astro';
import { etsyShopUrl, getProducts, sellsOnEtsy, settings, shopCategories } from '../../lib/content';
const products = await getProducts();
const categories = shopCategories(products);
const delivery = sellsOnEtsy ? '' : ` Free UK delivery over £${settings.freeDeliveryThreshold}.`;
---
<Base title="Shop" description={`Paper crafts, kits and printables from Sparkle by Kimberley.${delivery}`}>
  <section class="page-hero confetti">
    <div class="container">
      <h1>The Sparkle Shop</h1>
      {sellsOnEtsy ? (
        <p>Everything here comes from our <a href={etsyShopUrl} target="_blank" rel="noopener">Etsy shop</a>, so you can check out safely with Etsy.</p>
      ) : (
        <p>Hand-picked kits and supplies to go with our tutorials, plus printables you can download straight away.{delivery}</p>
      )}
    </div>
  </section>
  <section class="container shop"><ShopGrid products={products} categories={categories} /></section>
</Base>
<style>.shop { padding-bottom: 4rem; }</style>
