---
import Base from '../../../layouts/Base.astro';
import ShopGrid from '../../../components/ShopGrid.astro';
import { getProducts, shopCategories, slugify } from '../../../lib/content';

export async function getStaticPaths() {
  const products = await getProducts();
  const categories = shopCategories(products);
  return categories.map((c) => ({
    params: { category: slugify(c) },
    props: { name: c, categories, products: products.filter((p) => p.data.category === c) },
  }));
}
const { name, categories, products } = Astro.props;
---
<Base title={`${name} | Shop`} description={`Shop ${name.toLowerCase()} at Sparkle by Kimberley. Paper crafts and supplies.`}>
  <section class="page-hero confetti">
    <div class="container"><h1>{name}</h1></div>
  </section>
  <section class="container shop"><ShopGrid products={products} categories={categories} current={name} /></section>
</Base>
<style>.shop { padding-bottom: 4rem; }</style>
