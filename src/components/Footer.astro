---
import Logo from './Logo.astro';
import Wave from './Wave.astro';
import { settings } from '../lib/content';
const year = new Date().getFullYear();
---
<Wave from="var(--blush)" to="var(--charcoal)" />
<footer class="site-footer">
  <div class="container cols">
    <div>
      <div class="logo-wrap"><Logo /></div>
      <p>Free paper craft tutorials for grown-ups and little hands, plus a cheerful little shop. Made with love in the UK.</p>
      <ul class="social" aria-label="Social media">
        {settings.social.map((s) => <li><a href={s.url} rel="noopener me">{s.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        <li><a href="/tutorials">All tutorials</a></li>
        <li><a href="/tutorials?audience=adults">Crafts for grown-ups</a></li>
        <li><a href="/kids-corner">Kids' Corner</a></li>
        <li><a href="/shop">Shop</a></li>
        <li><a href="/about">About Kimberley</a></li>
        <li><a href="/contact">Contact &amp; FAQ</a></li>
      </ul>
    </div>
    <div>
      <h2>Shopping</h2>
      <ul>
        <li><a href="/delivery">Delivery information</a></li>
        <li><a href="/returns">Returns &amp; refunds</a></li>
        <li><a href="/terms">Terms &amp; conditions</a></li>
        <li><a href="/cart">Your basket</a></li>
      </ul>
    </div>
    <div>
      <h2>The small print</h2>
      <ul>
        <li><a href="/privacy">Privacy policy</a></li>
        <li><a href="/cookies">Cookie policy</a></li>
        <li><button type="button" class="linkish" data-open-cookie-settings>Cookie settings</button></li>
        <li><a href="/affiliate-disclosure">Affiliate disclosure</a></li>
        <li><a href="/accessibility">Accessibility</a></li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p>© {year} Sparkle by Kimberley. All prices in £ {settings.priceNote}.</p>
  </div>
</footer>
<style>
  .site-footer { background: var(--charcoal); color: #f4eeec; padding: 2.5rem 0 1.5rem; }
  .cols { display: grid; gap: 2rem; grid-template-columns: 1.5fr repeat(3, 1fr); }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .cols { grid-template-columns: 1fr; } }
  h2 { font-size: 1.05rem; color: var(--yellow); }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: .4rem; }
  a, .linkish { color: #f4eeec; }
  a:hover, .linkish:hover { color: var(--yellow); }
  .linkish { background: none; border: 0; padding: 0; font: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .logo-wrap { background: var(--white); display: inline-block; padding: .6rem 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; }
  .social { display: flex; flex-wrap: wrap; gap: .4rem .9rem; }
  .legal { border-top: 1px solid #4a4646; margin-top: 2rem; padding-top: 1rem; font-size: .95rem; }
</style>
