---
import { API_URL } from '../lib/content';
---
<section class="newsletter confetti" aria-labelledby="club-title">
  <div class="box">
    <span class="script eyebrow">Free printables</span>
    <h2 id="club-title">Join the Sparkle Club for free printables</h2>
    <p>One cheerful email a month with new tutorials, seasonal templates and the odd subscriber-only treat. No spam, ever, and you can leave any time.</p>
    <form class="form" data-newsletter action={`${API_URL}/api/newsletter`} method="post">
      <div class="row">
        <div>
          <label for="nl-name">First name</label>
          <input id="nl-name" name="name" type="text" autocomplete="given-name" />
        </div>
        <div>
          <label for="nl-email">Email address</label>
          <input id="nl-email" name="email" type="email" required autocomplete="email" />
        </div>
      </div>
      <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <label class="checkbox"><input type="checkbox" name="adult" required /> <span>I'm 18 or over and happy to get the Sparkle Club email. The club is for grown-ups only.</span></label>
      <button class="btn btn--pink sparkle-hover" type="submit">Join the club</button>
      <p class="msg" role="status" aria-live="polite"></p>
      <p class="small">We'll only use your email for the newsletter. See our <a href="/privacy">privacy policy</a>.</p>
    </form>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector('.msg')!;
      const btn = form.querySelector('button')!;
      btn.disabled = true;
      msg.textContent = 'Sprinkling some sparkle…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!res.ok) throw new Error();
        form.reset();
        msg.textContent = "You're in! Check your inbox for a welcome email with your free printables.";
      } catch {
        msg.textContent = 'Oops, that didn’t work. Please try again in a moment.';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
<style>
  .newsletter { padding: clamp(2.5rem, 6vw, 4rem) 1rem; }
  .box { max-width: 720px; margin: 0 auto; background: var(--white); border: 3px solid var(--charcoal); border-radius: var(--radius); padding: clamp(1.4rem, 4vw, 2.4rem); box-shadow: 8px 8px 0 var(--turquoise); }
  .eyebrow { color: var(--pink-ink); font-size: 1.3rem; }
  .form { display: grid; gap: .9rem; }
  .row { display: grid; gap: .9rem; grid-template-columns: 1fr 1.4fr; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
  .msg { font-weight: 800; margin: 0; min-height: 1.4em; }
  .small { font-size: .95rem; color: var(--muted); margin: 0; }
</style>
